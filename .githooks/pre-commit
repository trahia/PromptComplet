#!/bin/sh
# PromptComplet — contrôle avant chaque commit.
# Ne jamais le contourner (--no-verify) : corriger le problème signalé.

node promptcomplet/scripts/scanner-secrets.mjs --staged || exit 1
node promptcomplet/scripts/verifier-conformite.mjs --pre-commit || exit 1

# Gitleaks, s'il est installé sur la machine (recommandé).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
fi

exit 0
